<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cloud sync with the user's own Supabase project (Phase 6). Nothing else is contacted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Budget alerts (Android 13+ asks the user; earlier versions grant it at install). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup=false: financial data must not leave the device through
        Android Auto Backup. An explicit encrypted backup/restore mechanism is
        planned for a later phase (see docs/ENGINEERING_SPEC.md).
    -->
    <application
        android:name=".FinTrackApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinTrack"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialized on demand with the Hilt worker factory (FinTrackApplication),
             so only its App Startup entry is removed; the provider itself stays for other libraries. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
