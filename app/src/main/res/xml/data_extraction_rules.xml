<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ ignores allowBackup for device-to-device transfer, so every
    domain is excluded explicitly. Financial data stays on this device until
    the explicit encrypted backup feature exists.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
